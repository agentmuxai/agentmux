{
    "$schema": "https://unpkg.com/knip@5/schema.json",
    "entry": [
        "scripts/**/*.{js,mjs,cjs}",
        "tools/**/*.{js,mjs}",
        "sdk/**/*.{js,mjs,ts}",
        "crates/**/*.js",
        "test/fixtures/fake-xterm/server.mjs",
        "frontend/**/*.{darwin,linux}.{ts,tsx}"
    ],
    "ignore": ["docs/examples/**"],
    "ignoreFiles": [
        "frontend/types/rpc/**",
        "public/**",
        "sdk/**/*.css",
        "frontend/**/*.{darwin,linux,win32}.scss"
    ],
    "ignoreDependencies": [
        "@emnapi/core",
        "@emnapi/runtime",
        "@emnapi/wasi-threads",
        "react"
    ],
    "ignoreBinaries": [
        "task"
    ]
}
