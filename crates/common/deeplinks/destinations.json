{
    "$comment": "The one registry of deep-link destinations (docs/specs/SPEC_DEEP_LINKS_ONE_FRAMEWORK_2026_11_20.md §4, R10). Both sides generate their tables from this file: node scripts/gen-deeplinks.mjs (--check in CI). Ids, never labels, in every segment (R6). A label is an i18n key of frontend/app/i18n/locales/en.json. Kinds of a variable segment or a parameter: enum, id, slug, int, opaque, path, name.",
    "grammar": 1,
    "build": 1,
    "maxBytes": 512,
    "separator": "›",
    "errors": {
        "too_long": "the link is longer than 512 bytes",
        "not_agentmux": "the link does not start with agentmux://",
        "bad_syntax": "the link is not written as agentmux://view/place?key=value#anchor",
        "bad_encoding": "the link has a broken percent-encoding",
        "double_encoded": "the link is percent-encoded twice",
        "control_char": "the link holds a control or text-direction character",
        "not_canonical": "the link is not in its one written form (lower-case ids, upper-case hex, parameters in their order)",
        "unknown_view": "this place needs a newer AgentMux, or is not an AgentMux place",
        "unknown_place": "this place needs a newer AgentMux, or is not a place of that view",
        "unknown_param": "this parameter needs a newer AgentMux, or is not one of that place's",
        "unknown_anchor": "that place has nothing inside it to point at",
        "duplicate_param": "a parameter is written twice",
        "empty_param": "a parameter has no value",
        "bad_value": "a value is not of its kind (a number, an id, a name)",
        "bad_path": "the path is not an absolute local path a link may open",
        "missing_place": "that view opens only at a place inside it",
        "not_yet": "AgentMux cannot open this place yet"
    },
    "views": [
        {
            "id": "settings",
            "label": "deeplinks.views.settings",
            "icon": "cog",
            "build": 1,
            "effect": "none",
            "sensitivity": "public",
            "agent": "yes",
            "surfaces": ["desktop"],
            "command": "app:settings",
            "keywords": ["preferences", "options"],
            "group": "views",
            "places": [
                {
                    "id": "section",
                    "segments": [
                        {
                            "var": "section",
                            "kind": "enum",
                            "values": [
                                { "id": "appearance", "label": "settings.sections.appearance" },
                                { "id": "animations", "label": "settings.sections.animations" },
                                { "id": "window", "label": "settings.sections.window" },
                                { "id": "browser", "label": "settings.sections.browser" },
                                { "id": "terminal", "label": "settings.sections.terminal" },
                                { "id": "keyboard", "label": "settings.sections.keyboard" },
                                { "id": "sounds", "label": "settings.sections.sounds" },
                                { "id": "notifications", "label": "settings.sections.notifications" },
                                { "id": "recording", "label": "settings.sections.recording" },
                                { "id": "devices", "label": "settings.sections.devices" },
                                { "id": "widgets", "label": "settings.sections.widgets" },
                                { "id": "agents", "label": "settings.sections.agents" },
                                { "id": "supervisor", "label": "settings.sections.supervisor" },
                                { "id": "kanban", "label": "settings.sections.kanban" },
                                { "id": "advanced", "label": "settings.sections.advanced" }
                            ]
                        }
                    ],
                    "sections": true,
                    "anchor": { "kind": "id", "label": "deeplinks.anchors.setting" },
                    "params": [{ "name": "board", "kind": "slug", "label": "deeplinks.params.board", "onlyWith": { "section": ["kanban"] } }]
                }
            ]
        },
        {
            "id": "vault",
            "label": "deeplinks.views.vault",
            "icon": "vault",
            "build": 1,
            "effect": "none",
            "sensitivity": "secret",
            "agent": "yes",
            "surfaces": ["desktop"],
            "command": "open:vault",
            "keywords": ["secrets", "passwords", "keys"],
            "group": "views",
            "places": [
                {
                    "id": "section",
                    "segments": [
                        {
                            "var": "section",
                            "kind": "enum",
                            "values": [
                                { "id": "personal", "label": "deeplinks.places.vault.personal" },
                                { "id": "cards", "label": "deeplinks.places.vault.cards" },
                                { "id": "api-keys", "label": "deeplinks.places.vault.api-keys" },
                                { "id": "logins", "label": "deeplinks.places.vault.logins" },
                                { "id": "notes", "label": "deeplinks.places.vault.notes" },
                                { "id": "kept", "label": "deeplinks.places.vault.kept" },
                                { "id": "activity", "label": "deeplinks.places.vault.activity" }
                            ]
                        }
                    ],
                    "sections": true
                },
                {
                    "id": "entry",
                    "label": "deeplinks.places.vault.entry",
                    "segments": ["entry", { "var": "entry", "kind": "opaque" }]
                },
                {
                    "id": "request",
                    "label": "deeplinks.places.vault.request",
                    "segments": ["request", { "var": "request", "kind": "id" }]
                }
            ]
        },
        {
            "id": "connectors",
            "label": "deeplinks.views.connectors",
            "icon": "plug",
            "build": 1,
            "effect": "none",
            "sensitivity": "public",
            "agent": "yes",
            "surfaces": ["desktop"],
            "command": "app:connectors",
            "keywords": ["accounts", "mcp", "remotes", "ssh"],
            "group": "views",
            "places": [
                {
                    "id": "section",
                    "segments": [
                        {
                            "var": "section",
                            "kind": "enum",
                            "values": [
                                { "id": "accounts", "label": "deeplinks.places.connectors.accounts" },
                                { "id": "mcp", "label": "deeplinks.places.connectors.mcp" },
                                { "id": "remotes", "label": "deeplinks.places.connectors.remotes" }
                            ]
                        }
                    ],
                    "sections": true,
                    "anchor": { "kind": "id", "label": "deeplinks.anchors.card" }
                }
            ]
        },
        {
            "id": "memory",
            "label": "deeplinks.views.memory",
            "icon": "brain",
            "build": 1,
            "effect": "none",
            "sensitivity": "private",
            "agent": "yes",
            "surfaces": ["desktop"],
            "command": "app:memory",
            "keywords": ["instructions", "skills", "bundles"],
            "group": "views",
            "places": [
                {
                    "id": "section",
                    "segments": [
                        {
                            "var": "section",
                            "kind": "enum",
                            "values": [
                                { "id": "global", "label": "deeplinks.places.memory.global" },
                                { "id": "personal", "label": "deeplinks.places.memory.personal" },
                                { "id": "skills", "label": "deeplinks.places.memory.skills" },
                                { "id": "bundles", "label": "deeplinks.places.memory.bundles" }
                            ]
                        }
                    ],
                    "sections": true,
                    "params": [{ "name": "agent", "kind": "id", "label": "deeplinks.params.agent", "onlyWith": { "section": ["personal"] }, "agentOwn": true }]
                }
            ]
        },
        {
            "id": "kanban",
            "label": "deeplinks.views.kanban",
            "icon": "table-columns",
            "build": 1,
            "effect": "none",
            "sensitivity": "public",
            "agent": "yes",
            "surfaces": ["desktop"],
            "command": "open:kanban",
            "keywords": ["tasks", "board", "queue"],
            "group": "views",
            "places": [
                {
                    "id": "task",
                    "label": "deeplinks.places.kanban.task",
                    "segments": ["task", { "var": "task", "kind": "int", "min": 1, "max": 999999999 }]
                },
                {
                    "id": "board",
                    "label": "deeplinks.places.kanban.board",
                    "segments": ["board", { "var": "board", "kind": "slug" }]
                },
                {
                    "id": "pulls",
                    "label": "deeplinks.places.kanban.pulls",
                    "segments": ["pulls"]
                },
                {
                    "id": "board-task",
                    "label": "deeplinks.places.kanban.task",
                    "segments": ["board", { "var": "board", "kind": "slug" }, "task", { "var": "task", "kind": "int", "min": 1, "max": 999999999 }]
                }
            ]
        },
        {
            "id": "swarm",
            "label": "deeplinks.views.swarm",
            "icon": "diagram-project",
            "build": 1,
            "effect": "none",
            "sensitivity": "public",
            "agent": "yes",
            "surfaces": ["desktop"],
            "command": "open:swarm",
            "keywords": ["agents", "supervisor"],
            "group": "views",
            "places": [
                {
                    "id": "section",
                    "segments": [
                        {
                            "var": "section",
                            "kind": "enum",
                            "values": [
                                { "id": "supervisor", "label": "deeplinks.places.swarm.supervisor" },
                                { "id": "broadcast", "label": "deeplinks.places.swarm.broadcast" }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "audit",
            "label": "deeplinks.views.audit",
            "icon": "clipboard-list",
            "build": 1,
            "effect": "none",
            "sensitivity": "private",
            "agent": "own",
            "surfaces": ["desktop"],
            "group": "views",
            "places": [
                {
                    "id": "agent",
                    "label": "deeplinks.places.audit.agent",
                    "segments": ["agent", { "var": "agent", "kind": "id", "agentOwn": true }]
                },
                {
                    "id": "sound",
                    "label": "deeplinks.places.audit.sound",
                    "segments": ["sound", { "var": "sound", "kind": "id" }]
                },
                {
                    "id": "message",
                    "label": "deeplinks.places.audit.message",
                    "segments": ["message", { "var": "message", "kind": "id" }]
                },
                {
                    "id": "section",
                    "sections": true,
                    "segments": [
                        {
                            "var": "section",
                            "kind": "enum",
                            "values": [
                                { "id": "events", "label": "deeplinks.places.audit.events" },
                                { "id": "conversations", "label": "deeplinks.places.audit.conversations" },
                                { "id": "typed", "label": "deeplinks.places.audit.typed" },
                                { "id": "storage", "label": "deeplinks.places.audit.storage" }
                            ]
                        }
                    ]
                }
            ]
        },
        { "id": "atlas", "label": "deeplinks.views.atlas", "icon": "map", "build": 1, "effect": "none", "sensitivity": "public", "agent": "yes", "surfaces": ["desktop"], "group": "views", "places": [] },
        { "id": "drone", "label": "deeplinks.views.drone", "icon": "diagram-project", "build": 1, "effect": "none", "sensitivity": "public", "agent": "yes", "surfaces": ["desktop"], "group": "views", "places": [] },
        { "id": "toolchain", "label": "deeplinks.views.toolchain", "icon": "wrench", "build": 1, "effect": "none", "sensitivity": "public", "agent": "yes", "surfaces": ["desktop"], "group": "views", "places": [] },
        { "id": "tower", "label": "deeplinks.views.tower", "icon": "tower-observation", "build": 1, "effect": "none", "sensitivity": "public", "agent": "yes", "surfaces": ["desktop"], "group": "views", "places": [] },
        { "id": "help", "label": "deeplinks.views.help", "icon": "circle-question", "build": 1, "effect": "none", "sensitivity": "public", "agent": "yes", "surfaces": ["desktop"], "group": "views", "places": [] },
        { "id": "shortcuts", "label": "deeplinks.views.shortcuts", "icon": "shapes", "build": 1, "effect": "none", "sensitivity": "public", "agent": "yes", "surfaces": ["desktop"], "group": "views", "places": [] },
        { "id": "sysinfo", "label": "deeplinks.views.sysinfo", "icon": "chart-line", "build": 1, "effect": "none", "sensitivity": "public", "agent": "yes", "surfaces": ["desktop"], "command": "open:sysinfo", "group": "views", "places": [] },
        {
            "id": "editor",
            "label": "deeplinks.views.editor",
            "icon": "file-lines",
            "build": 1,
            "effect": "none",
            "sensitivity": "path",
            "agent": "yes",
            "surfaces": ["desktop"],
            "group": "files",
            "places": [
                {
                    "id": "file",
                    "label": "deeplinks.places.editor.file",
                    "segments": [{ "var": "path", "kind": "path" }],
                    "params": [
                        { "name": "line", "kind": "int", "min": 1, "max": 9999999, "label": "deeplinks.params.line" },
                        { "name": "offset", "kind": "int", "min": 0, "max": 2147483647, "label": "deeplinks.params.offset" }
                    ]
                }
            ]
        },
        {
            "id": "media",
            "paneView": "editor",
            "label": "deeplinks.views.media",
            "icon": "photo-film",
            "build": 1,
            "effect": "none",
            "sensitivity": "path",
            "agent": "yes",
            "surfaces": ["desktop"],
            "group": "files",
            "places": [
                {
                    "id": "file",
                    "label": "deeplinks.places.editor.file",
                    "segments": [{ "var": "path", "kind": "path" }]
                }
            ]
        },
        {
            "id": "files",
            "label": "deeplinks.views.files",
            "icon": "folder-open",
            "build": 1,
            "effect": "none",
            "sensitivity": "path",
            "agent": "yes",
            "surfaces": ["desktop"],
            "command": "open:files",
            "group": "files",
            "places": [
                {
                    "id": "folder",
                    "label": "deeplinks.places.files.folder",
                    "segments": [{ "var": "path", "kind": "path" }],
                    "params": [{ "name": "select", "kind": "name", "label": "deeplinks.params.select" }]
                }
            ]
        },
        {
            "id": "agent",
            "label": "deeplinks.views.agent",
            "icon": "wand-magic-sparkles",
            "build": 2,
            "effect": "starts",
            "sensitivity": "private",
            "agent": "reveal",
            "surfaces": ["desktop"],
            "group": "agents",
            "places": [{ "id": "agent", "label": "deeplinks.places.agent.agent", "segments": [{ "var": "agent", "kind": "id" }] }],
            "requiresPlace": true
        },
        {
            "id": "statusbar",
            "paneView": null,
            "label": "deeplinks.views.statusbar",
            "icon": "bars-progress",
            "build": 2,
            "effect": "none",
            "sensitivity": "public",
            "agent": "yes",
            "surfaces": ["desktop"],
            "group": "views",
            "places": [
                {
                    "id": "panel",
                    "segments": [
                        {
                            "var": "panel",
                            "kind": "enum",
                            "values": [
                                { "id": "version", "label": "deeplinks.places.statusbar.version" },
                                { "id": "maintenance", "label": "deeplinks.places.statusbar.maintenance" },
                                { "id": "host", "label": "deeplinks.places.statusbar.host" },
                                { "id": "cpu", "label": "deeplinks.places.statusbar.cpu" }
                            ]
                        }
                    ]
                }
            ],
            "requiresPlace": true
        },
        {
            "id": "term",
            "label": "deeplinks.views.term",
            "icon": "terminal",
            "build": 2,
            "effect": "starts",
            "sensitivity": "private",
            "agent": "reveal",
            "surfaces": ["desktop"],
            "group": "views",
            "places": [{ "id": "pane", "label": "deeplinks.places.term.pane", "segments": [{ "var": "block", "kind": "id" }] }],
            "requiresPlace": true
        },
        {
            "id": "browser",
            "label": "deeplinks.views.browser",
            "icon": "globe",
            "build": 2,
            "effect": "network",
            "sensitivity": "private",
            "agent": "reveal",
            "surfaces": ["desktop"],
            "group": "views",
            "places": [{ "id": "pane", "label": "deeplinks.places.browser.pane", "segments": [{ "var": "block", "kind": "id" }] }],
            "requiresPlace": true
        },
        {
            "id": "ext",
            "prefix": true,
            "paneView": "ext",
            "label": "deeplinks.views.ext",
            "icon": "puzzle-piece",
            "build": 3,
            "effect": "none",
            "sensitivity": "widget",
            "agent": "approved",
            "surfaces": ["desktop"],
            "group": "widgets",
            "places": [{ "id": "pane", "label": "deeplinks.places.ext.pane", "segments": [{ "var": "pane", "kind": "id" }] }],
            "requiresPlace": true
        }
    ],
    "aliases": [
        { "from": ["task", "{task}"], "to": ["kanban", "task", "{task}"] },
        { "from": ["reviews"], "to": ["kanban", "pulls"] },
        { "from": ["history"], "to": ["audit", "conversations"] }
    ],
    "unlinked": [
        { "view": "identity", "reason": "retired: its parts live in Connectors and the agent pane" },
        { "view": "warden", "reason": "Jobs only, reached through the drone view" }
    ]
}
