# Canonical GN args for the AgentMux patched libcef.so (Linux x64).
#
# This is the EXACT configuration that produced the libcef.so shipped in the
# v0.45.0 release (stripped 263 MB → 134 MB AppImage — the smallest of the three
# platforms). Treat it as the source of truth; `docs/cef-build/build-patched-libcef.md`
# defers to this file. `scripts/cef-build/configure-cef-build.sh` copies it into the
# build tree's out/Release_GN_x64/args.gn and runs `gn gen`.
#
# The first block is CEF's standard GN_DEFINES set (what `cef_create_projects.sh`
# emits for a non-component Release). The size-reduction block at the bottom is the
# AgentMux addition — see the comment there.

# use_static_angle=false (added 2026-09-15, CEF 152 upgrade, Phase D) — this
# file previously had no `use_static_angle` override, which was fine at 148
# (Chromium's resolved default at that milestone produced a real ANGLE-linked
# libEGL.so/libGLESv2.so without needing this set). At 152 the declared
# default (ui/gl/features.gni: `use_static_angle = true`) combines with
# ui/gl/BUILD.gn's `use_angle_stubs = use_static_angle && (is_linux || is_win
# || is_mac)` to ship DUMMY stub libEGL.so/libGLESv2.so instead ("some bot
# infrastructure expects these files to exist even in static builds" — i.e.
# placeholders, not a real GL implementation). Compiles with ZERO errors and
# ZERO warnings; the shipped runtime has no working GPU/WebGL
# (`eglGetProcAddress` not found at init, falls back to neither hardware NOR
# SwiftShader — GPU fully disabled, not degraded). Confirmed directly: the
# built libEGL.so/libGLESv2.so (963,712 / 963,912 bytes) export neither
# `eglGetProcAddress` nor `glGetString` (`scripts/verify-angle-libs.sh`), and
# — unlike macOS, which statically links real ANGLE straight into the
# framework binary and is correct leaving this unset (see
# args-darwin.gn) — a full `nm` symbol-table search of libcef.so itself found
# zero `angle::`/`rx::` symbols, so Linux is not that case either. This is
# the identical bug Korp found and fixed for Windows in args-windows.gn
# (#3172) — that fix does not cover Linux; the `is_linux || is_win || is_mac`
# gate means each platform's args file needs the same line independently.
# See docs/specs/SPEC_CEF_MILESTONE_UPGRADE_148_TO_152_2026_09_07.md's Phase D
# section for the full investigation across all three platforms.
use_static_angle=false

blink_heap_inside_shared_library=true
clang_use_chrome_plugins=false
enable_background_mode=false
enable_downgrade_processing=false
enable_linux_installer=false
enable_resource_allowlist_generation=false
enable_widevine=true
forbid_non_component_debug_builds=false
is_component_build=false
is_debug=false
optimize_webui=true
target_cpu="x64"
use_qt5=false
use_qt6=false
use_sysroot=false

# --- proprietary codec support (added 2026-07-26): wide file-type coverage ---
# See docs/specs/SPEC_CEF_PROPRIETARY_CODECS_ALL_PLATFORMS_2026_07_26.md and
# docs/reports/REPORT_CEF_PROPRIETARY_CODEC_GAP_2026_07_26.md for the root
# cause (MP4/MOV, and formats needing these below, failed to play anywhere
# in the app — DEMUXER_ERROR_NO_SUPPORTED_STREAMS — because no CEF build in
# this pipeline ever enabled these).
#
# proprietary_codecs + ffmpeg_branding="Chrome" is the core gate: H.264,
# AAC, MP3, MP4 demuxing. enable_hevc_parser_and_hw_decoder is already
# true by default here (proprietary_codecs && is_linux, per Chromium's own
# media/media_options.gni) — set explicitly anyway so the file is
# self-describing rather than relying on an unstated default.
# enable_platform_ac3_eac3_audio and enable_platform_dolby_vision default
# to FALSE on desktop Linux (their defaults only cover Cast devices/tvOS/
# — Dolby Vision defaults true on Windows only) — both need the explicit
# override below to get AC3/EAC3 (common in MP4/MKV rips) and Dolby Vision
# HDR video working here too.
#
# Widevine (enable_widevine=true below, pre-existing) is the same class of
# licensed/gated component — this isn't a new kind of decision for this
# build, just a new instance of one already made.
proprietary_codecs=true
ffmpeg_branding="Chrome"
enable_hevc_parser_and_hw_decoder=true
enable_platform_ac3_eac3_audio=true
enable_platform_dolby_vision=true

# --- size reduction (added 2026-06-14): official-build optimizations ---
# is_official_build=true is THE size lever — it enables thin-LTO,
# identical-code-folding, and full optimization, roughly halving libcef.so
# (~414 MB → ~263 MB stripped; AppImage ~190 → ~135 MB). Do not omit it.
# is_cfi / chrome_pgo_phase are disabled only to skip their profile/setup
# dependencies — they do NOT drive size. Verified on CEF 148.0.7778.180.
#
# Gotcha: is_official_build rebuilds V8, so after building you MUST copy the
# fresh snapshot_blob.bin + v8_context_snapshot.bin alongside libcef.so or the
# host crashes on a checksum mismatch (the AppImage packager handles this).
is_official_build=true
use_thin_lto=true
is_cfi=false
chrome_pgo_phase=0
