// AgentMux Settings
// Save this file to apply changes immediately.
// Uncomment a line to override its default value.
//
// Docs: https://docs.agentmux.ai/settings
{
    // -- Terminal --
    // "term:fontsize":            15,
    // "term:fontfamily":          "Hack",
    // "term:theme":               "default-dark",
    // "term:scrollback":          2000,
    // "term:copyonselect":        false,
    // "term:transparency":        0.5,
    // "term:scrollsensitivity":   1,
    // "term:localshellpath":      "/bin/bash",  // example; unset uses your shell
    // "term:localshellopts":      [],
    // "term:disablewebgl":        false,
    // "term:allowbracketedpaste": true,
    // "term:shiftenternewline":   false,

    // -- Drag and drop (file drop onto Terminal / Agent panes) --
    // "dnd:enabled":              true,
    // "dnd:concurrency":          4,            // example; unset means no limit
    // "dnd:agentinserttoken":     true,

    // -- Window --
    // "window:transparent":       false,
    // "window:blur":              false,
    // "window:opacity":           0.8,
    // "window:bgcolor":           "",
    // "window:zoom":              1.0,
    // "window:tilegapsize":       3,
    // "window:showmenubar":       false,
    // "window:nativetitlebar":    false,
    // "window:confirmclose":      false,
    // "window:savelastwindow":    true,
    // "window:keepinactivetabslaidout": true,
    // "window:dimensions":        "",
    // "window:reducedmotion":     false,
    // "window:magnifiedblockopacity": 1.0,
    // "window:magnifiedblocksize":    0.9,
    // "window:maxtabcachesize":   10,
    // "window:disablehardwareacceleration": false,

    // -- Pane colors --
    // Color per widget type, keyed by view ("term", "agent", ...): a hue 0-360,
    // or null for none. Remove a key to return to the built-in color.
    // "pane:colors":              {},

    // -- Startup --
    // Suppress the splash screen. Applies at the NEXT launch: the launcher
    // reads this before the app itself is running.
    // "splash:disabled":          false,

    // -- App --
    // Keep running with a system-tray icon when all windows are closed
    // (background-service mode). Off by default (opt-in): closing the last
    // window quits. Applies at the NEXT launch: the launcher reads this
    // before the app itself is running.
    // "app:runinbackground":      false,
    // Show an icon in the system tray / menu bar while AgentMux is running.
    // On by default. Always shown while app:runinbackground is on. Applies at
    // the NEXT launch.
    // "app:showtray":             true,
    // Start at login (off by default). Same switch as the tray menu's
    // "Start at login".
    // "app:startatlogin":         false,
    // "app:defaultnewblock":      "",
    // "app:showoverlayblocknums": true,

    // -- Shell Environment --
    // "cmd:env":                  {},

    // -- Telemetry --
    // "telemetry:enabled":        true,
    // "telemetry:interval":       1.0,
    // "telemetry:numpoints":      120,

    // -- Connections --
    // "conn:wshenabled":          true,
    // "conn:askbeforewshinstall": true,

    // -- Notification sounds --
    // "notify:sounds:enabled":                  true,
    // "notify:sounds:volume":                   0.6,
    // "notify:sounds:suppresswhenfocused":      true,
    // "notify:sound:agent.turn.complete":       true,
    // "notify:sound:agent.turn.error":          true,
    // "notify:sound:agent.turn.interrupted":    true,
    // "notify:sound:agent.message.accepted":    true,
    // "notify:sound:agent.message.rejected":    true,
    // Play a soft looping tone while an agent is waiting for your reply.
    // "notify:sound:agent.waiting.for.input":   true,
    // "notify:sounds:waiting:volume":           0.25,  // 0–1, scaled by notify:sounds:volume

    // -- Desktop notifications (OS toasts) --
    // "notify:os:enabled":                      true,
    // "notify:os:when":                         "unfocused",  // "unfocused" | "always" | "never"
    // "notify:os:inputwaiting":                 true,
    // "notify:os:turncompleted":                true,
    // "notify:os:turncompleted:external":       false,  // turns you didn't start
    // "notify:os:turnerrored":                  true,
    // "notify:os:agentcrashed":                 true,
    // "notify:os:messageneedsreview":           true,
    // "notify:os:cloudsignedout":               true,
    // "notify:pause:until":                     0,            // epoch ms; set from the tray
    // "notify:pause:allowattention":            false,
    // "notify:taskbar:attention":               true,         // badge + flash the taskbar button
    // "notify:quiethours":                      "",           // e.g. "22:00-08:00" (local time)
    // "notify:os:preview":                      "redacted",   // "redacted" | "full" | "none"
    // "notify:os:summary":                      true,         // the agent's session summary under the body

    // -- Tool-call tones (subliminal per-tool "voice") --
    // "notify:tooltones:enabled":               true,
    // "notify:tooltones:volume":                0.25,
    // "notify:tooltones:scope":                 "all",  // "all" or "focused"
    // "notify:tooltones:flash":                 true,   // flash the source tab with each sound (tones + event sounds)

    // -- Voice input (speech-to-text) --
    // "voice:enabled":          true,       // show the per-pane mic button (default true)
    // "voice:engine":           "groq",     // "groq" (hosted Whisper, default),
    //                                       // "whisper-local" (offline whisper.cpp), or
    //                                       // "webspeech" (browser API — does NOT work in
    //                                       // packaged CEF builds; dev/Chromium only)
    // -- groq engine: hosted, sends webm. Key read server-side only (never sent to UI).
    // "voice:groqApiKey":       "gsk_...",  // example; or set AGENTMUX_GROQ_API_KEY
    // -- whisper-local engine: offline, sends 16kHz WAV to a local whisper.cpp CLI.
    //    Provide the whisper-cli binary path; the GGML model auto-downloads on
    //    first use (default "base.en", ~142MB) to <config>/whisper-models/.
    //    Env override for the binary: AGENTMUX_WHISPER_CLI.
    // "voice:whisperCliPath":   "C:/tools/whisper-cli.exe",  // example
    // "voice:whisperModel":     "base.en",   // tiny.en | base.en | small.en | …
    // "voice:whisperModelPath": "C:/models/ggml-base.en.bin",  // example; explicit override; skips auto-download

    // -- Network --
    // Discover other AgentMux instances on your local network (mDNS/Bonjour)
    // so agents on different machines can message each other directly,
    // without going through the cloud.
    //
    // Default FALSE, deliberately: turning this on makes the app advertise
    // and browse on the local network, which triggers the OS local-network
    // permission prompt (macOS) / firewall prompt (Windows). Not worth
    // bothering someone who only ever runs agents on one machine — turn it
    // on when you actually want cross-machine agent messaging.
    //
    // Must be enabled on BOTH machines: discovery is mutual, so a peer with
    // this off is invisible even if you have it on.
    // "network:lan_discovery":     false,

    // -- Cloud --
    // Publish this computer to my devices: while signed in to MuxBus Cloud,
    // your signed-in devices can list this computer from anywhere. Turning
    // it off also tells them it went offline. Dev builds, headless installs
    // and isolated homes never publish.
    // "cloud:publishpresence":     true,

    // -- Agents --
    // Tell an agent, in a short [AgentMux] note, when it edits a file another
    // agent on this computer is also changing, so it can message them first.
    // "agent:overlapnotes":        true,

    // -- Other --
    // "widget:icononly":           false,
    // "blockheader:showblockids": false,
    // "preview:showhiddenfiles":  false,
    // "tab:preset":               ""
}
