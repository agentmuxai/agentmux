{
  "name": "@agentmuxai/widget-sdk",
  "version": "1.2.0",
  "description": "The client for sandboxed AgentMux widgets: connect to AgentMux from a widget's page and use the widget API. Its agentmux-widget command signs widget packages.",
  "type": "module",
  "main": "./v1.js",
  "types": "./v1.d.ts",
  "bin": {
    "agentmux-widget": "./bin/agentmux-widget.mjs"
  },
  "exports": {
    ".": {
      "types": "./v1.d.ts",
      "default": "./v1.js"
    },
    "./am-widget.css": "./am-widget.css"
  },
  "files": [
    "v1.js",
    "v1.d.ts",
    "am-widget.css",
    "bin/agentmux-widget.mjs",
    "README.md"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agentmuxai/agentmux.git",
    "directory": "sdk/widget-sdk"
  },
  "keywords": [
    "agentmux",
    "widget",
    "sdk"
  ],
  "homepage": "https://docs.agentmux.ai/build-a-widget/",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
