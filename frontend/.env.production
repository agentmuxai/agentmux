# MuxBus Cloud Auth
# VITE_MUXBUS_COGNITO_DOMAIN and VITE_MUXBUS_CLIENT_ID enable the AgentMux
# Cloud sign-in button in Connectors → Accounts → AgentMux.
#
# VITE_MUXBUS_COGNITO_DOMAIN is the branded sign-in domain:
#   prod env → auth.agentmux.ai
# It and VITE_MUXBUS_CLIENT_ID are only the fallback, a pair used together: a sign-in
# follows what AgentMux Cloud publishes (muxbus/discovery.rs) whenever it answers.
#
# VITE_MUXBUS_CLIENT_ID is a public PKCE client ID — safe to commit.
# Both values are provisioned by the AgentMux cloud service's maintainers.

VITE_MUXBUS_COGNITO_DOMAIN=https://auth.agentmux.ai
VITE_MUXBUS_CLIENT_ID=52dsl1vr7b3mteb6e0mnp297mm
