# MuxBus Cloud Auth
# VITE_MUXBUS_COGNITO_DOMAIN and VITE_MUXBUS_CLIENT_ID enable the AgentMux
# Cloud sign-in button in Armory → Accounts → AgentMux.
#
# VITE_MUXBUS_COGNITO_DOMAIN is the branded sign-in domain:
#   prod env → auth.muxbus.agentmux.ai
# The legacy prefix domain stays live for already-installed
# builds; new builds point at the branded host.
#
# VITE_MUXBUS_CLIENT_ID is a public PKCE client ID — safe to commit.
# Both values are provisioned by the AgentMux cloud service's maintainers.

VITE_MUXBUS_COGNITO_DOMAIN=https://auth.muxbus.agentmux.ai
VITE_MUXBUS_CLIENT_ID=26odoigu6a7r8ecdmj5egvnc3b
