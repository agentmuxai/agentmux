{
    "surface": {
        "--main-bg-color": "color-mix(in srgb, var(--surface) calc(var(--window-opacity, 1) * 100%), transparent)",
        "--block-bg-color": "color-mix(in srgb, var(--surface) calc(var(--window-opacity, 1) * 100%), transparent)",
        "--elevated-bg-color": "var(--surface-raised)",
        "--modal-bg-color": "var(--surface-overlay)",
        "--menu-bg-color": "var(--surface-overlay)",
        "--panel-bg-color": "color-mix(in srgb, var(--surface-raised) 50%, transparent)",
        "--block-bg-solid-color": "var(--surface)",
        "--tab-strip-bg": "color-mix(in srgb, var(--ink-text) 3%, transparent)",
        "--input-bg-color": "color-mix(in srgb, var(--ink-text) 8%, transparent)",
        "--highlight-bg-color": "color-mix(in srgb, var(--ink-text) 20%, transparent)"
    },
    "ink": {
        "--main-text-color": "--ink-text",
        "--secondary-text-color": "--ink-muted",
        "--tertiary-text-color": "--ink-faint",
        "--border-color": "--ink-border",
        "--menu-edge-color": "--ink-border",
        "--accent-color": "--ink-accent",
        "--accent-fg-color": "--ink-accent",
        "--link-color": "--ink-accent",
        "--error-color": "--ink-error",
        "--error-text-color": "--ink-error",
        "--warning-color": "--ink-warning",
        "--warning-text-color": "--ink-warning",
        "--success-color": "--ink-success",
        "--success-text-color": "--ink-success",
        "--attention-color": "--ink-attention",
        "--attention-text-color": "--ink-on-attention",
        "--hover-bg-color": "--ink-hover",
        "--grey-text-color": "--ink-faint",
        "--info-color": "--ink-info",
        "--file-tree-text-color": "--ink-text",
        "--accent-text-color": "--ink-on-accent"
    },
    "channels": [
        "--accent-color-rgb"
    ],
    "ansi": [
        "--term-blue",
        "--term-bright-blue",
        "--term-bright-cyan",
        "--term-bright-green",
        "--term-bright-magenta",
        "--term-cyan",
        "--term-green",
        "--term-magenta",
        "--term-yellow"
    ],
    "syntax": [
        "--syntax-comment",
        "--syntax-constant",
        "--syntax-function",
        "--syntax-invalid",
        "--syntax-keyword",
        "--syntax-name",
        "--syntax-operator",
        "--syntax-plain",
        "--syntax-string",
        "--syntax-type"
    ],
    "glyphs": [
        "--file-icon-blue",
        "--file-icon-green",
        "--file-icon-grey",
        "--file-icon-orange",
        "--file-icon-pink",
        "--file-icon-purple",
        "--file-icon-red",
        "--file-icon-steel",
        "--file-icon-yellow"
    ],
    "windowLevel": [
        "--app-warning-color"
    ]
}
