{
  "name": "@agentmux/desktop",
  "version": "0.2.9",
  "description": "AgentMux Desktop - Native desktop app for agent monitoring and orchestration",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:cli": "bats tests/cli/*.bats",
    "test:cli:single": "bats tests/cli/single_instance.bats",
    "test:cli:ipc": "bats tests/cli/ipc_forwarding.bats",
    "test:all": "npm run test && npm run test:cli"
  },
  "dependencies": {
    "@agentmux/core": "*",
    "@tauri-apps/api": "^2.2.0",
    "solid-js": "^1.9.3"
  },
  "devDependencies": {
    "@solidjs/testing-library": "^0.8.5",
    "@tauri-apps/cli": "^2.2.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/user-event": "^14.5.1",
    "@vitest/ui": "^1.0.0",
    "jsdom": "^23.0.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.0",
    "vite-plugin-solid": "^2.8.2",
    "vitest": "^1.0.0"
  }
}
