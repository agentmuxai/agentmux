{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "BlockDef": {
      "properties": {
        "files": {
          "additionalProperties": {
            "$ref": "#/$defs/FileDef"
          },
          "type": "object"
        },
        "meta": {
          "$ref": "#/$defs/MetaMapType"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "FileDef": {
      "properties": {
        "content": {
          "type": "string"
        },
        "meta": {
          "type": "object"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "MetaMapType": {
      "type": "object"
    },
    "WidgetConfigType": {
      "properties": {
        "display:order": {
          "type": "number"
        },
        "display:hidden": {
          "type": "boolean"
        },
        "display:pinned": {
          "type": "boolean",
          "description": "Pinned to the widget bar by default on a fresh install. Ignored once the user has a widget:pinned setting."
        },
        "icon": {
          "type": "string"
        },
        "color": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "magnified": {
          "type": "boolean"
        },
        "children": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "module": {
          "type": "string",
          "description": "A v1 third-party widget: path to its ES module, relative to ~/.agentmux/widgets/ or absolute."
        },
        "blockdef": {
          "$ref": "#/$defs/BlockDef"
        }
      },
      "additionalProperties": false,
      "type": "object"
    }
  },
  "additionalProperties": {
    "$ref": "#/$defs/WidgetConfigType"
  },
  "type": "object"
}