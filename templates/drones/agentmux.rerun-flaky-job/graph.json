{
  "nodes": [
    {
      "id": "flaky",
      "position": {
        "x": 0,
        "y": 0
      },
      "data": {
        "kind": "condition",
        "expr": "{{trigger.item.run_attempt}} == 1 && {{trigger.item.name}} == '{{param.workflow}}'"
      }
    },
    {
      "id": "rerun",
      "position": {
        "x": 240,
        "y": -80
      },
      "data": {
        "kind": "api",
        "url": "https://api.github.com/repos/{{param.repo}}/actions/runs/{{trigger.key}}/rerun-failed-jobs",
        "headers": {
          "Accept": "application/vnd.github+json",
          "X-GitHub-Api-Version": "2022-11-28",
          "User-Agent": "AgentMux-Drone"
        },
        "auth": {
          "vault": "{{param.credential}}",
          "as": "bearer"
        },
        "method": "POST"
      }
    },
    {
      "id": "ok",
      "position": {
        "x": 480,
        "y": -80
      },
      "data": {
        "kind": "condition",
        "expr": "{{rerun.status}} == 201"
      }
    },
    {
      "id": "tell",
      "position": {
        "x": 720,
        "y": -160
      },
      "data": {
        "kind": "message",
        "to": "{{param.leader}}",
        "body": "Run {{trigger.key}} of {{trigger.item.name}} failed on its first attempt and was re-run once ({{trigger.item.html_url}}). No reply needed."
      }
    },
    {
      "id": "refused",
      "position": {
        "x": 720,
        "y": 0
      },
      "data": {
        "kind": "message",
        "to": "{{param.leader}}",
        "body": "Run {{trigger.key}} of {{trigger.item.name}} failed on its first attempt, but GitHub refused the re-run (status {{rerun.status}}), so nothing was re-run ({{trigger.item.html_url}}). It will not be tried again. No reply needed."
      }
    }
  ],
  "edges": [
    {
      "id": "flaky-rerun",
      "source": "flaky",
      "target": "rerun",
      "sourceHandle": "true"
    },
    {
      "id": "rerun-ok",
      "source": "rerun",
      "target": "ok"
    },
    {
      "id": "ok-tell",
      "source": "ok",
      "target": "tell",
      "sourceHandle": "true"
    },
    {
      "id": "ok-refused",
      "source": "ok",
      "target": "refused",
      "sourceHandle": "false"
    }
  ]
}
