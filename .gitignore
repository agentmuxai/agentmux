# Cargo workspace
/target/
backend-test/
test/screenshots/

# Legacy Tauri build artifacts. The Tauri host was removed (CLAUDE.md
# "There is only one host"); leftover dirs from old branches/checkouts
# can be tens of GB of cargo target output that should never get tracked.
src-tauri/

# CEF binaries (downloaded at build time by cef-dll-sys)
agentmux-cef/cef_binary/
agentmux-cef/resources/

# Screenshots (development artifacts)
ss-*.png
ss2.png
screenshot*.png
nul

# scripts/ui-screenshots/ capture output — timestamped run directories of
# PNGs for the UI manual. Deliberately not committed (see
# docs/specs/SPEC_UI_MANUAL_SCREENSHOT_TOOLING_2026_09_19.md §5): a person
# curating the manual copies the specific images they want to keep into the
# manual's own asset directory under a stable name, rather than every
# capture run's raw output living in git history.
docs/manual/screenshots/

# AppImage build artifacts (assembled in build/AgentMux.AppDir/ before being bundled by appimagetool)
/build/AgentMux.AppDir/

# Claude Code agent session state — worktrees, logs, todos, etc.
.claude/

# macOS packaging build artifact (signed .app — never commit)
build/AgentMux.app/
build/AgentMux.AppDir/

# Python bytecode from local tooling scripts
__pycache__/
*.pyc
