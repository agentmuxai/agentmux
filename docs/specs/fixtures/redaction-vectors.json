        "input": "x-api-key: abc123",
        "expected": "x-api-key: [redacted]"
    },
    {
        "name": "cookie-header",
        "input": "Cookie: session=abc123",
        "expected": "Cookie: [redacted]"
    },
    {
        "name": "set-cookie-header",
        "input": "Set-Cookie: session=abc123; Path=/",
        "expected": "Set-Cookie: [redacted]"
    },
    {
